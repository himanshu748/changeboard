# Local sample mode works with no secrets and no external service.
PORT=4310
HOST=127.0.0.1
APP_ORIGIN=http://127.0.0.1:4310
DATA_DIR=work/data

# Production: PostgreSQL connection and an exact HTTPS public origin.
# DATABASE_URL=postgresql://...
# APP_ORIGIN=https://changeboard.example
# HOST=0.0.0.0

# Register a private/server OAuth client in Buffer Settings > API > App Clients.
# Enable account:read, posts:read, posts:write; offline_access is requested in OAuth.
BUFFER_CLIENT_ID=
BUFFER_CLIENT_SECRET=
BUFFER_REDIRECT_URI=
# Generate locally: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Public immutable media URLs; defaults to APP_ORIGIN. Must be HTTPS for live uploads.
# PUBLIC_MEDIA_ORIGIN=https://changeboard.example
PUBLICATION_CUTOFF_MINUTES=10

# Optional TLS development server; callback must use HTTPS even on localhost.
# TLS_KEY_FILE=work/certs/localhost-key.pem
# TLS_CERT_FILE=work/certs/localhost.pem

# Empty means NO live format is enabled. Populate only after real test receipts exist.
# LIVE_FORMAT_EVIDENCE_FILE=work/live-format-evidence.json
